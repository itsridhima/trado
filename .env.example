# EASIEST AND SAFEST: run  python -m trado --setup  . It stores your key in a private folder on your PC
# that cloud sync (OneDrive etc.) does not copy, and nothing needs editing by hand.
#
# Advanced: you can instead copy this file to ".env" and paste your key after the = sign. ".env" is
# gitignored, so git never uploads it, but do NOT keep it inside a OneDrive/Dropbox folder.
# Never share the key or post it anywhere.

# Free key from https://console.groq.com/keys. One Groq key is all Trado needs (speech and AI answers).
# In the Groq console, consider switching on its "Zero Data Retention" data control.
GROQ_API_KEY=

# --- Optional settings (safe to leave as they are) ---
# Which keys to hold while talking. Default: ctrl+alt_l (Ctrl plus the LEFT Alt key).
# Other examples: ctrl+alt (either Alt), f9, ctrl_r, ctrl+shift+space
TRADO_HOTKEY=ctrl+alt_l
# Speech-to-text provider name
TRADO_STT_PROVIDER=groq
# Speech model on Groq. whisper-large-v3 is the most accurate free one;
# whisper-large-v3-turbo is a little faster but a little less accurate.
TRADO_STT_MODEL=whisper-large-v3
# Language you speak. "en" (default) is the most reliable for English. Use "hi" for Hindi,
# or "auto" to let Whisper guess (it often guesses wrong on short clips).
TRADO_STT_LANGUAGE=en
# Leave blank for the Windows default microphone. To pick another, run: python -m trado --mics
TRADO_MIC_DEVICE=
# Play a short beep when the mic is ready. Start talking after it.
TRADO_BEEP=true
# Show extra numbers (speech confidence) to help fix problems.
TRADO_DEBUG=false

# --- AI answers (Slice 2) ---
# Vision model on Groq. Llama 4 Scout was shut down on 17 Jul 2026, so we use Qwen 3.8 27B.
# Check console.groq.com/docs/vision for the current name if this ever stops working.
TRADO_LLM_MODEL=qwen/qwen3.8-27b
TRADO_LLM_PROVIDER=groq
# "none" turns off slow step-by-step thinking (faster answers). Blank = don't send the setting.
TRADO_LLM_REASONING=none
# true = send a screenshot of the screen under your mouse with each question. false = question only.
TRADO_SEND_SCREEN=true

# --- Voice out (Slice 3) ---
# windows = built-in Windows voice (free, offline). off = text only, no speaking.
TRADO_TTS=windows
# Part of a voice name. To see yours, run: python -m trado --voices   (blank = Windows default)
TRADO_VOICE=
# Speaking speed from -10 (slow) to 10 (fast). 0 is normal.
TRADO_VOICE_RATE=1

# --- Privacy ---
# What to do when the window in front looks like a login, KYC, bank or broker page:
#   ask  = show a Yes/No box before sending a screenshot (default)
#   skip = never send a screenshot of those pages
#   send = don't check (not recommended)
TRADO_SENSITIVE_PAGES=ask
# Advanced: full path of a key file kept somewhere private. Blank = use the private local folder.
TRADO_ENV_FILE=

# --- Memory ---
# How many of your recent questions Trado remembers, so "and what does that mean?" works. 0 = no memory.
# The remembered text is sent to Groq with each question. It is never saved to disk and is cleared when you quit.
TRADO_MEMORY=5
